# ==============================================================================
# Pump Master Pro — Example Environment Configuration Template
# ==============================================================================
# Instructions:
#   1. Copy this file to '.env' (or 'pump-app/.env'):
#      cp .env.example .env
#   2. Fill in your actual database credentials below.
#   3. NEVER commit your real '.env' file to version control.
# ==============================================================================

PYTHONPATH=pump-app

# ── Microsoft SQL Server Connection ───────────────────────────────────────────
# Option A: Full Connection URI
# Example: mssql+pyodbc://<user>:<password>@<host>:<port>/<dbname>?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=mssql+pyodbc://<DB_USER>:<DB_PASSWORD>@<DB_SERVER>/<DB_NAME>?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Option B: Discrete Parameters (alternatively used by config.py)
# DB_SERVER=your-db-server.com,1435
# DB_NAME=PumpMasterPro
# DB_USER=your_db_username
# DB_PASSWORD=your_db_password
# DB_DRIVER=ODBC Driver 17 for SQL Server

# ── Application Secret ─────────────────────────────────────────────────────────
SESSION_SECRET=your-random-generated-session-secret-string-here

# ── Environment & Debug ───────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
PORT=8000
