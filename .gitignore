# Ignore local backup folders
.git_backup/
Pump-Master-Pro/.git_backup/

# Ignore large zip file
Pump-Master-Pro.zip

# Ignore local env and cache
.env
.cache/
.local/
node_modules/
dist/
tmp/

# Python compiled files
__pycache__/
*.py[cod]
*$py.class

# Databases — ignore runtime DBs but keep seed data
*.sqlite
*.sqlite3
pump_app.db
pump_master.db
# pumps.db is intentionally tracked — it is the seed database needed for deployment
# Do NOT add pumps.db here

