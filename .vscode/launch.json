{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Flask App (Pump Master Pro)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Pump-Master-Pro/pump-app/app.py",
      "cwd": "${workspaceFolder}/Pump-Master-Pro/pump-app",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/Pump-Master-Pro/pump-app",
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/Pump-Master-Pro/pump-app",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/Pump-Master-Pro/pump-app"
      },
      "console": "integratedTerminal"
    }
  ]
}
